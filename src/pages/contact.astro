---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import TodoNote from "../components/TodoNote.astro";
import { site } from "../data/site";

const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=-97.318%2C29.922%2C-97.290%2C29.940&layer=mapnik&marker=${site.geo.lat}%2C${site.geo.lng}`;
---

<Base
  title="Contact | Connect Today—Reach Out Now"
  description="Contact Rosanky Baptist Church for questions, prayer, or to get connected. We’re here to support and serve you through faith and community."
  pageType="ContactPage"
  leaf="Contact"
>
  <PageHero
    title="Contact us"
    lede="Question? Need? Please get in contact, and we’ll reply as soon as possible."
  />
  <section class="band band-tight">
    <div class="band-inner contact-grid">
    <div class="panel">
      <h2 class="panel-title">Send a message</h2>
      <p class="times-note">
        The previous site used a Squarespace form with Name, Email, Subject, and Message.
      </p>
      <form id="contact-form" class="form-grid">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" required autocomplete="name" />
        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div>
          <label for="subject">Subject</label>
          <input id="subject" name="subject" required />
        </div>
        <div>
          <label for="message">Message</label>
          <textarea id="message" name="message" required rows="6"></textarea>
        </div>
        <button type="submit" class="btn">Submit</button>
        <p id="contact-note" class="times-note" hidden>Your email app should open with this message addressed to {site.email}.</p>
      </form>
    </div>
    <div class="stack">
      <div class="panel">
        <h2 class="panel-title">Visit or call</h2>
        <p class="day-label">Church address</p>
        <p class="address">
          <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </p>
        <p class="address-meta">
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="address">
          <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">
            {site.streetLine1}<br />{site.city}, {site.region} {site.postalCode}
          </a>
        </p>
        <p class="times-note">Sunday 9:00 AM Bible Study · 10:00 AM Worship</p>
      </div>
      <iframe
        title="Map of Rosanky Baptist Church at 2160 Farm to Market 535, Rosanky, Texas"
        src={mapSrc}
        class="map-embed"
        loading="lazy"
      ></iframe>
      <TodoNote title="TODO — confirm before publishing">
        <p>
          The phone in the site footer and the tap-to-call link is {site.phoneDisplay}. The site’s business settings list a different number, {site.phoneBusinessSettings}. Confirm which number should be primary.
        </p>
        <p>
          The email {site.email} comes from the site’s business information. It is not printed in the visible footer.
        </p>
        <p>
          The old contact form submitted to Squarespace with a captcha. This static form opens an email to {site.email}. Connect a form service if submissions should stay on the website.
        </p>
        <p>
          The Bible and Life show names Dr. Mark Redd as interim pastor. A fuller staff list and a sermon archive beyond that show are not published on the current site. The church Facebook page is {site.facebook}. Header icons on the old site point at Squarespace’s own Instagram and X accounts, which are template defaults, so those are not listed here.
        </p>
        <p>
          The footer “Get Connected” button on the old site has an empty link. This site points it to the existing /get-connected page.
        </p>
      </TodoNote>
    </div>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const subject = String(data.get("subject") || "Message from the church website");
    const body = [
      `Name: ${data.get("name") || ""}`,
      `Email: ${data.get("email") || ""}`,
      "",
      String(data.get("message") || ""),
    ].join("\n");
    const note = document.getElementById("contact-note");
    if (note) note.hidden = false;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
