---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import TodoNote from "../components/TodoNote.astro";
import { site } from "../data/site";

const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=-97.318%2C29.922%2C-97.290%2C29.940&layer=mapnik&marker=${site.geo.lat}%2C${site.geo.lng}`;
---

<Base
  title="Contact | Connect Today—Reach Out Now"
  description="Contact Rosanky Baptist Church for questions, prayer, or to get connected. We’re here to support and serve you through faith and community."
>
  <PageHero
    title="Contact us"
    lede="Question? Need? Please get in contact, and we’ll reply as soon as possible."
  />
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-2 md:px-6">
    <div>
      <h2 class="font-serif text-2xl">Send a message</h2>
      <p class="mt-2 text-ink-soft">
        The previous site used a Squarespace form with Name, Email, Subject, and Message.
      </p>
      <form id="contact-form" class="mt-6 space-y-4">
        <div>
          <label class="block text-sm font-semibold" for="name">Name</label>
          <input id="name" name="name" required autocomplete="name" class="mt-1 w-full rounded-lg border border-cream-deep bg-paper px-3 py-2" />
        </div>
        <div>
          <label class="block text-sm font-semibold" for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="mt-1 w-full rounded-lg border border-cream-deep bg-paper px-3 py-2" />
        </div>
        <div>
          <label class="block text-sm font-semibold" for="subject">Subject</label>
          <input id="subject" name="subject" required class="mt-1 w-full rounded-lg border border-cream-deep bg-paper px-3 py-2" />
        </div>
        <div>
          <label class="block text-sm font-semibold" for="message">Message</label>
          <textarea id="message" name="message" required rows="6" class="mt-1 w-full rounded-lg border border-cream-deep bg-paper px-3 py-2"></textarea>
        </div>
        <button type="submit" class="rounded-full bg-brick px-5 py-3 font-semibold text-paper">Submit</button>
        <p id="contact-note" class="text-sm text-ink-soft" hidden>Your email app should open with this message addressed to {site.email}.</p>
      </form>
    </div>
    <div class="space-y-6">
      <div class="rounded-2xl bg-paper p-6">
        <h2 class="font-serif text-2xl">Visit or call</h2>
        <p class="mt-3 text-lg font-semibold">
          <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </p>
        <p class="mt-1">
          <a href={`mailto:${site.email}`} class="font-semibold text-brick">{site.email}</a>
        </p>
        <p class="mt-3">
          <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
            {site.streetLine1}<br />{site.city}, {site.region} {site.postalCode}
          </a>
        </p>
        <p class="mt-3 text-sm text-ink-soft">Sunday 9:00 AM Bible Study · 10:00 AM Worship</p>
      </div>
      <iframe
        title="Map of Rosanky Baptist Church at 2160 Farm to Market 535, Rosanky, Texas"
        src={mapSrc}
        class="h-72 w-full rounded-2xl border border-cream-deep"
        loading="lazy"
      ></iframe>
      <TodoNote title="TODO — confirm before publishing">
        <p>
          The phone in the site footer and the tap-to-call link is {site.phoneDisplay}. The site’s business settings list a different number, {site.phoneBusinessSettings}. Confirm which number should be primary.
        </p>
        <p>
          The email {site.email} comes from the site’s business information. It is not printed in the visible footer.
        </p>
        <p>
          The old contact form submitted to Squarespace with a captcha. This static form opens an email to {site.email}. Connect a form service if submissions should stay on the website.
        </p>
        <p>
          No pastor or staff names, sermon archive, or church-owned social profiles are published on the current site. Header icons on the old site point at Squarespace’s own Instagram, Facebook, and X accounts, which are template defaults, so they are not listed here.
        </p>
        <p>
          The footer “Get Connected” button on the old site has an empty link. This site points it to the existing /get-connected page.
        </p>
      </TodoNote>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const subject = String(data.get("subject") || "Message from the church website");
    const body = [
      `Name: ${data.get("name") || ""}`,
      `Email: ${data.get("email") || ""}`,
      "",
      String(data.get("message") || ""),
    ].join("\n");
    const note = document.getElementById("contact-note");
    if (note) note.hidden = false;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
