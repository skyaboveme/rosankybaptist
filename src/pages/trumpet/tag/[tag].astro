---
import { allPosts, formatDate } from "../../../lib/trumpet";
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";

export async function getStaticPaths() {
  const posts = await allPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await allPosts()).filter((post) => post.data.tags.includes(tag));
---

<Base title={`${tag} — Trumpet News`} description={`Trumpet News posts tagged ${tag}.`} pageType="CollectionPage">
  <PageHero eyebrow="Trumpet News" title={tag} lede="Posts with this tag on the current church site." />
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <ul class="space-y-6">
      {
        posts.map((post) => (
          <li>
            <a href={`/trumpet/${post.id}`} class="block rounded-2xl bg-paper p-5 ring-1 ring-cream-deep hover:bg-cream">
              <p class="text-sm font-semibold text-brick">{formatDate(post.data.date)}</p>
              <h2 class="mt-1 font-serif text-2xl">{post.data.title}</h2>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a href="/trumpet" class="font-semibold text-brick hover:underline">All Trumpet News</a>
    </p>
  </div>
</Base>
