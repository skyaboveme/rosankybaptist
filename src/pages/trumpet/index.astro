---
import { allPosts, formatDate, termHref } from "../../lib/trumpet";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const posts = await allPosts();
const categories = [...new Set(posts.flatMap((post) => post.data.categories))].sort();
---

<Base
  title="Trumpet News"
  description="Trumpet News from Rosanky Baptist Church: newsletters, events, and stories from the church family."
  pageType="CollectionPage"
  leaf="Trumpet News"
>
  <PageHero
    eyebrow="Newsletter"
    title="Trumpet News"
    lede="Newsletters and stories published on the church site. Every post on the current site is bylined Mission Design Services."
  />
  <div class="page-wrap" style="padding-top:1.2rem">
    {
      categories.length > 0 && (
        <ul class="tag-row">
          {categories.map((category) => (
            <li>
              <a href={termHref("category", category)}>{category}</a>
            </li>
          ))}
        </ul>
      )
    }
    <div class="story-index">
      {
        posts.map((post) => (
          <a href={`/trumpet/${post.id}`}>
            {post.data.cover ? (
              <img src={post.data.cover} alt="" width="240" height="160" loading="lazy" />
            ) : (
              <span></span>
            )}
            <span>
              <h2>{post.data.title}</h2>
              <p class="ink-soft mt-1">{post.data.description}</p>
            </span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </a>
        ))
      }
    </div>
  </div>
</Base>
