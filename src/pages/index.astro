---
import Base from "../layouts/Base.astro";
import CampusDetails from "../components/CampusDetails.astro";
import { site } from "../data/site";

const family = [
  {
    src: "/images/gallery/kite.jpg",
    alt: "A young girl with a backpack and jacket smiling and holding a small red kite outdoors at night, with string lights and hay bales in the background.",
    title: "Children",
    body: "Check in your children for their Bible Study Classes. After family praise, children’s church proceeds to their classes. Nursery available.",
    href: "/visit",
    label: "What to expect",
  },
  {
    src: "/images/gallery/woj.jpg",
    alt: "Church photo from the Rosanky Baptist Church gallery (original file name woj 26.jpg).",
    title: "Bible study",
    body: "Find one of the many Adult Bible Study classes we offer. Bible study is at 9:00 AM, before worship.",
    href: "/visit",
    label: "I'm new",
  },
  {
    src: "/images/gallery/announcer.jpg",
    alt: "The announcer, Bro JR, from a Rosanky Baptist Church gathering.",
    title: "The church family",
    body: "Download Church Center and search “Rosanky Baptist Church” for the calendar, giving, and more. Members sign in there too.",
    href: "/get-connected",
    label: "Get connected",
  },
];

const steps = [
  { href: "/visit", title: "I'm new here" },
  { href: "/pray-for-me", title: "Pray for me" },
  { href: site.podcastShow, title: "Bible and Life", external: true },
  { href: "/give", title: "I want to give" },
  { href: "/calendar", title: "See the calendar" },
  { href: "/trumpet", title: "Read Trumpet News" },
  { href: site.facebook, title: "See us on Facebook", external: true },
];
---

<Base title="Rosanky Baptist Church | Join Our Faith Community Today">
  <section class="campus-hero">
    <img
      src="/video/hero-poster.jpg"
      alt="Aerial view of the Rosanky Baptist Church building and steeple."
      width="1280"
      height="720"
      fetchpriority="high"
    />
    <video
      class="hero-video"
      muted
      autoplay
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-hero-video
    ></video>
    <div class="hero-copy">
      <h1>Rosanky</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-times">Sundays · 9:00 Bible study · 10:00 worship</p>
      <p class="hero-actions">
        <a class="btn btn-cream" href="/visit">I'm new</a>
        <a class="btn btn-ghost" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Directions</a>
      </p>
    </div>
  </section>

  <section class="band" aria-label="What's happening">
    <div class="band-inner promo-grid">
      <a class="overlay-card" href="/visit">
        <img
          src="/images/gallery/gathering.jpg"
          alt="Two older women smiling at an outdoor gathering, one wearing a green jacket and the other a leopard print shirt, holding cups, with other people in the background."
          width="800"
          height="600"
        />
        <span class="scrim" aria-hidden="true"></span>
        <span class="overlay-copy">
          <span class="overlay-kicker">This Sunday</span>
          <span class="overlay-title">Plan your visit</span>
          <span class="overlay-text">
            We are a Christ Centered, Caring Church Family. Bible study at 9:00 AM and worship at 10:00 AM every Sunday.
          </span>
          <span class="btn btn-cream">I'm new</span>
        </span>
      </a>

      <article class="media-card">
        <a href={site.pinewoodForm} target="_blank" rel="noopener noreferrer">
          <img
            src="/images/pinewood-derby.png"
            alt="Community Pinewood Derby invitation from Rosanky Baptist Church."
            width="1200"
            height="800"
          />
        </a>
        <div class="media-card-body">
          <p class="day-label">Upcoming</p>
          <h2>Start your engines, Rosanky.</h2>
          <p>You're invited to a community Pinewood Derby race hosted by Rosanky Baptist Church.</p>
          <ul>
            <li>Sunday, November 15 at 5:00 PM</li>
            <li>Trophies for Fastest Car and Most Creative Car</li>
            <li>Free food and refreshments</li>
          </ul>
          <p>
            You don't have to race to join the fun. Come cheer on the racers, enjoy some food, and spend time with friends and neighbors. This event is for everyone in our community.
          </p>
          <p>
            <a class="btn" href={site.pinewoodForm} target="_blank" rel="noopener noreferrer">Sign up</a>
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="band band-tight" aria-label="Service times and campus">
    <div class="band-inner">
      <CampusDetails />
    </div>
  </section>

  <section class="connect-band">
    <div class="band-inner connect-grid">
      <div class="connect-card">
        <h2>Stay connected</h2>
        <p>
          Stay connected and get the latest content. Download “Church Center” on any app store and search “Rosanky Baptist Church” to view the calendar, give, and more. Pictures and news from the church family are on Facebook.
        </p>
        <p class="connect-actions">
          <a class="btn btn-cream" href={site.churchCenter} target="_blank" rel="noopener noreferrer">Church Center</a>
          <a class="btn btn-cream" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        </p>
      </div>
      <ul class="step-list">
        {
          steps.map((step) => (
            <li>
              <a
                href={step.href}
                target={step.external ? "_blank" : undefined}
                rel={step.external ? "noopener noreferrer" : undefined}
              >
                <span>{step.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-tight" aria-labelledby="bible-and-life-heading">
    <div class="band-inner panel">
      <h2 id="bible-and-life-heading" class="panel-title">Bible and Life</h2>
      <p class="times-note">
        Biblical preaching and practical teaching from Dr. Mark Redd, interim pastor of Rosanky Baptist Church.
      </p>
      <iframe
        class="spotify-embed"
        title="Bible and Life with Dr. Mark Redd on Spotify"
        src={site.podcastShowEmbed}
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
      <p class="panel-action">
        <a class="btn" href={site.podcastShow} target="_blank" rel="noopener noreferrer">Listen on Spotify</a>
      </p>
    </div>
  </section>

  <section class="band" id="worship" aria-labelledby="sunday-heading">
    <div class="band-inner">
      <article class="feature">
        <img
          src="/images/gallery/cross.jpg"
          alt="Two people smiling in front of a wooden cross draped with purple and white cloth."
          width="800"
          height="600"
        />
        <div>
          <h2 id="sunday-heading">Sunday morning</h2>
          <p>
            Check in your children for their Bible Study Classes and find one of the many Adult Bible Study classes we offer.
          </p>
          <p>
            Family Praise and Worship takes place in the main sanctuary, and then the children’s church proceeds to their classes. Nursery available.
          </p>
          <p class="feature-meta">9:00 AM — Bible Study Classes</p>
          <p class="feature-meta">10:00 AM — Worship in the sanctuary, then children’s church. Nursery available.</p>
          <p>
            <a class="btn" href="/visit">I'm new</a>
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="band band-tight" aria-labelledby="family-heading">
    <div class="band-inner">
      <h2 id="family-heading" class="block-title">For your family</h2>
      <div class="family-grid">
        {
          family.map((card) => (
            <article class="family-card">
              <img src={card.src} alt={card.alt} width="800" height="600" loading="lazy" />
              <div class="family-card-body">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
                <a class="btn" href={card.href}>{card.label}</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <script>
    interface HeroNetworkInformation {
      saveData?: boolean;
      effectiveType?: string;
    }

    const desktopHeroSources: ReadonlyArray<readonly [string, string]> = [
      ["/video/hero.webm", "video/webm"],
      ["/video/hero.mp4", "video/mp4"],
    ];

    const mobileHeroSources: ReadonlyArray<readonly [string, string]> = [
      ["/video/hero-mobile.mp4", "video/mp4"],
    ];

    function networkSkipsHeroVideo(): boolean {
      const connection = (navigator as Navigator & { connection?: HeroNetworkInformation }).connection;
      if (!connection) return false;
      if (connection.saveData) return true;
      return connection.effectiveType === "slow-2g" || connection.effectiveType === "2g";
    }

    function usesMobileHero(): boolean {
      return window.matchMedia("(max-width: 640px), (max-height: 480px)").matches;
    }

    function shouldSkipHeroVideo(): boolean {
      return (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        networkSkipsHeroVideo()
      );
    }

    function enableInlineMutedPlayback(video: HTMLVideoElement): void {
      video.defaultMuted = true;
      video.muted = true;
      video.playsInline = true;
      video.setAttribute("muted", "");
      video.setAttribute("playsinline", "");
      video.setAttribute("webkit-playsinline", "");
    }

    function startHeroPlayback(video: HTMLVideoElement): void {
      enableInlineMutedPlayback(video);
      const playAttempt = video.play();
      if (playAttempt) {
        playAttempt.catch(() => {
          video.classList.remove("is-playing");
        });
      }
    }

    function attachHeroVideo(): void {
      const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
      if (!video || video.dataset.sourcesAttached === "true") return;
      if (shouldSkipHeroVideo()) return;

      video.dataset.sourcesAttached = "true";
      enableInlineMutedPlayback(video);

      const sources = usesMobileHero() ? mobileHeroSources : desktopHeroSources;
      for (const [src, type] of sources) {
        const source = document.createElement("source");
        source.src = src;
        source.type = type;
        video.append(source);
      }

      video.addEventListener(
        "playing",
        () => {
          video.classList.add("is-playing");
        },
        { once: true },
      );
      video.addEventListener("canplay", () => startHeroPlayback(video), { once: true });

      video.preload = "auto";
      video.load();
    }

    function scheduleHeroVideo(): void {
      const start = () => {
        if ("requestIdleCallback" in window) {
          requestIdleCallback(() => attachHeroVideo(), { timeout: 2000 });
        } else {
          window.setTimeout(attachHeroVideo, 200);
        }
      };

      if (document.readyState === "complete") start();
      else window.addEventListener("load", start, { once: true });
    }

    scheduleHeroVideo();
    document.addEventListener("astro:page-load", scheduleHeroVideo);
  </script>
</Base>
