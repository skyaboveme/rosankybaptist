---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const photos = [
  {
    src: "/images/gallery/gathering.jpg",
    alt: "Two older women smiling at an outdoor gathering, one wearing a green jacket and the other a leopard print shirt, holding cups, with other people in the background.",
  },
  {
    src: "/images/gallery/kite.jpg",
    alt: "A young girl with a backpack and jacket smiling and holding a small red kite outdoors at night, with string lights and hay bales in the background.",
  },
  {
    src: "/images/gallery/cross.jpg",
    alt: "Two people smiling in front of a wooden cross draped with purple and white cloth.",
  },
  {
    src: "/images/gallery/woj.jpg",
    alt: "Church photo from the Rosanky Baptist Church gallery (original file name woj 26.jpg).",
  },
  {
    src: "/images/gallery/angels.jpg",
    alt: "Church photo from the Rosanky Baptist Church gallery (original file name Angels.jpg).",
  },
  {
    src: "/images/gallery/announcer.jpg",
    alt: "The announcer, Bro JR, from a Rosanky Baptist Church gathering.",
  },
];

const ticker = "9:00 Bible Study  ·  10:00 Worship  ·  Nursery available  ·  2160 FM 535, Rosanky  ·  ";
---

<Base title="Rosanky Baptist Church | Join Our Faith Community Today">
  <section class="hero">
    <div>
      <p class="kicker"><span class="cross" aria-hidden="true"></span> Rosanky, Texas</p>
      <h1>
        The<br />
        <em>lighthouse</em><br />
        on the hillside.
      </h1>
      <p class="hero-lead">
        We are a Christ Centered, Caring Church Family. Bible study at 9:00 AM and worship at 10:00 AM every Sunday.
      </p>
      <p class="hero-actions">
        <a class="link-arrow" href="/visit">I'm new</a>
        <a class="link-arrow" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Directions</a>
      </p>
    </div>
    <figure class="hero-photo">
      <div class="beam" aria-hidden="true"></div>
      <img
        src="/images/worship.png"
        alt="People kneeling in prayer on the sanctuary steps during worship at Rosanky Baptist Church."
        width="1500"
        height="1000"
      />
      <figcaption>Sunday worship · the sanctuary</figcaption>
    </figure>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span>{ticker}{ticker}</span>
      <span>{ticker}{ticker}</span>
    </div>
  </div>

  <section class="sunday" aria-labelledby="sunday-heading">
    <div class="sunday-head">
      <h2 id="sunday-heading">Sunday morning</h2>
      <p class="hours-note">Sunday hours listed on the site: 9:00 AM–11:00 AM.</p>
    </div>
    <ol>
      <li>
        <time datetime="09:00">9:00</time>
        <div>
          <h3>Bible Study Classes</h3>
          <p>
            Check in your children for their Bible Study Classes and find one of the many Adult Bible Study classes we offer.
          </p>
        </div>
      </li>
      <li>
        <time datetime="10:00">10:00</time>
        <div>
          <h3>Worship Service</h3>
          <p>
            Family Praise and Worship takes place in the main sanctuary, and then the children’s church proceeds to their classes. Nursery available.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section class="derby" aria-labelledby="derby-heading">
    <a class="derby-flyer" href={site.pinewoodForm} target="_blank" rel="noopener noreferrer">
      <img
        src="/images/pinewood-derby.png"
        alt="Community Pinewood Derby invitation from Rosanky Baptist Church."
        width="1200"
        height="800"
      />
    </a>
    <div>
      <p class="kicker" style="color:#e7c98a">Featured on the church homepage</p>
      <h2 id="derby-heading">Start your engines, Rosanky.</h2>
      <p class="mt-4 text-lg text-cream/85">
        You're invited to a community Pinewood Derby race hosted by Rosanky Baptist Church.
      </p>
      <ul>
        <li>Sunday, November 15 at 5:00 PM</li>
        <li>Trophies for Fastest Car and Most Creative Car</li>
        <li>Free food and refreshments</li>
      </ul>
      <p class="mt-4 text-cream/80">
        You don't have to race to join the fun. Come cheer on the racers, enjoy some food, and spend time with friends and neighbors. This event is for everyone in our community.
      </p>
      <p class="mt-6">
        <a class="link-arrow" href={site.pinewoodForm} target="_blank" rel="noopener noreferrer">Sign up</a>
      </p>
    </div>
  </section>

  <section class="vision-band">
    <p>
      <span>Vision</span>
      {site.vision}
    </p>
  </section>

  <section class="band" aria-labelledby="give-heading">
    <div class="split">
      <div>
        <h2 id="give-heading" class="section-title">Give</h2>
        <p class="mt-4 max-w-xl text-lg ink-soft">
          Give on site Sunday morning, mail a check payable to “Rosanky Baptist Church” to {site.mailingAddress[0]}, {site.mailingAddress[1]}, or give online.
        </p>
        <p class="hero-actions">
          <a class="link-arrow" href={site.giveOnline} target="_blank" rel="noopener noreferrer">Give online</a>
          <a class="link-arrow" href="/give">Ways to give</a>
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="split">
      <div>
        <h2 class="section-title">Get the app</h2>
        <p class="mt-4 max-w-xl text-lg ink-soft">
          Stay connected and get the latest content. Download “Church Center” on any app store and search “Rosanky Baptist Church” to view the calendar, <a href={site.giveOnline} target="_blank" rel="noopener noreferrer">give</a>, and more.
        </p>
        <p class="mt-6">
          <a class="link-arrow" href={site.churchCenter} target="_blank" rel="noopener noreferrer">
            <img src="/images/church-center.png" alt="" width="28" height="28" class="inline h-7 w-7" />
            Church Center
          </a>
        </p>
      </div>
      <p class="ink-soft">
        <a class="link-arrow" href={site.mapUrl} target="_blank" rel="noopener noreferrer">{site.streetShort}</a>
        <br />
        <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
      </p>
    </div>
  </section>

  <section class="film-wrap" aria-labelledby="life-heading">
    <h2 id="life-heading">Life together</h2>
    <p class="ink-soft">Photographs from the church site. Slide sideways.</p>
    <ul class="filmstrip">
      {
        photos.map((photo) => (
          <li>
            <img src={photo.src} alt={photo.alt} width="800" height="600" loading="lazy" />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
