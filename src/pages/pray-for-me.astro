---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import TodoNote from "../components/TodoNote.astro";
import { site } from "../data/site";
---

<Base
  title="Pray For Me"
  description="Submit a prayer request to Rosanky Baptist Church, or listen to How To Pray for Your Church."
>
  <PageHero title="Please submit prayer requests here" lede="Our church staff prays for the requests entrusted to the church." />
  <section class="band band-tight">
    <div class="band-inner contact-grid">
    <div class="panel">
      <p class="times-note">
        The footer on the current site links “Pray For Me” to a Church Center form. The /pray-for-me page itself asks for Name, Phone, Email, and “How May We Pray For You?”
      </p>
      <p class="panel-action">
        <a class="btn" href={site.prayerForm} target="_blank" rel="noopener noreferrer">
          Open the prayer form
        </a>
      </p>
      <form id="prayer-form" class="form-grid">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" required autocomplete="name" />
        </div>
        <div>
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" required autocomplete="tel" />
        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div>
          <label for="request">How May We Pray For You?</label>
          <textarea id="request" name="request" required rows="6"></textarea>
        </div>
        <button type="submit" class="btn">Submit</button>
      </form>
      <div id="prayer-thanks" class="thanks" role="status" hidden>
        <p>Thank you for entrusting us to pray for you during this time.</p>
        <p>Our church staff is praying for you. Please let us know how else we can support you during this time.</p>
      </div>
    </div>
    <div class="stack">
    <div class="panel" id="listen">
      <h2 class="panel-title">How to pray for your church</h2>
      <p class="times-note">
        Listen to “How To Pray for Your Church,” from Bible and Life with Dr. Mark Redd. Seven ways to pray for your church, from Ephesians 3:14–21.
      </p>
      <iframe
        class="spotify-embed"
        title="How To Pray for Your Church, from Bible and Life with Dr. Mark Redd"
        src={site.prayerEpisodeEmbed}
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
      <p class="panel-action">
        <a class="btn" href={site.prayerEpisode} target="_blank" rel="noopener noreferrer">Listen on Spotify</a>
      </p>
    </div>
    <TodoNote title="TODO">
      <p>
        The on-site prayer form submitted to Squarespace with a captcha. The button above opens the live Church Center form. The fields here open an email to {site.email} until a form service is connected. The success message is the text the old form showed after a submission.
      </p>
    </TodoNote>
    </div>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById("prayer-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const body = [
      `Name: ${data.get("name") || ""}`,
      `Phone: ${data.get("phone") || ""}`,
      `Email: ${data.get("email") || ""}`,
      "",
      "How May We Pray For You?",
      String(data.get("request") || ""),
    ].join("\n");
    const thanks = document.getElementById("prayer-thanks");
    if (thanks) thanks.hidden = false;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent("Prayer request")}&body=${encodeURIComponent(body)}`;
  });
</script>
