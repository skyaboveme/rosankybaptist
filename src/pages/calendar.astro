---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<Base title="Rosanky Baptist Church Calendar" description="Rosanky Baptist Church Calendar">
  <PageHero
    title="Calendar"
    lede="The church calendar is hosted in Church Center, the same calendar embedded on the current site."
  />
  <section class="band band-tight">
    <div class="band-inner stack">
    <p>
      <a class="btn" href={`${site.churchCenter}calendar`} target="_blank" rel="noopener noreferrer">
        Open the calendar on Church Center
      </a>
    </p>
    <p class="times-note">The church calendar is hosted in Church Center. Use the button above if the embed does not load.</p>
    <div class="panel calendar-frame">
      <script is:inline src="https://rosankybc.churchcenter.com/assets/calendar_embed.js" data-height="auto"></script>
    </div>
    <noscript>
      <p class="mt-4">
        JavaScript is required for the embedded calendar.
        <a href={`${site.churchCenter}calendar`}>View it on Church Center.</a>
      </p>
    </noscript>
    </div>
  </section>
</Base>
