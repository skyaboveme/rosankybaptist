---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<Base title="Rosanky Baptist Church Calendar" description="Rosanky Baptist Church Calendar">
  <PageHero
    title="Calendar"
    lede="The church calendar is hosted in Church Center, the same calendar embedded on the current site."
  />
  <section class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <p class="mb-6">
      <a
        href={`${site.churchCenter}calendar`}
        class="font-semibold text-brick underline underline-offset-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open the calendar on Church Center
      </a>
      if the embed does not load.
    </p>
    <div class="overflow-hidden rounded-2xl bg-paper p-2 shadow-sm">
      <script is:inline src="https://rosankybc.churchcenter.com/assets/calendar_embed.js" data-height="auto"></script>
    </div>
    <noscript>
      <p class="mt-4">
        JavaScript is required for the embedded calendar.
        <a href={`${site.churchCenter}calendar`}>View it on Church Center.</a>
      </p>
    </noscript>
  </section>
</Base>
