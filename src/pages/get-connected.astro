---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import TodoNote from "../components/TodoNote.astro";
import { site } from "../data/site";

const paths = [
  {
    href: "/visit",
    title: "Plan a Sunday",
    body: "Bible study at 9:00 AM and worship at 10:00 AM. Nursery is available, and children’s church follows family praise in the sanctuary.",
  },
  {
    href: site.churchCenter,
    title: "Church Center",
    body: "Download Church Center and search “Rosanky Baptist Church” for the calendar, giving, and more. Members also sign in here.",
    external: true,
  },
  {
    href: "/pray-for-me",
    title: "Pray For Me",
    body: "Share a prayer request with the church.",
  },
  {
    href: site.podcastShow,
    title: "Bible and Life",
    body: "Biblical preaching and practical teaching from Dr. Mark Redd, interim pastor of Rosanky Baptist Church.",
    external: true,
  },
  {
    href: "/give",
    title: "Give",
    body: "Give on site Sunday morning, mail a check to PO BOX 96, or give online.",
  },
  {
    href: site.facebook,
    title: "Facebook",
    body: "See pictures and news from the church family on our Facebook page.",
    external: true,
  },
];
---

<Base
  title="Get Connected"
  description="Ways to get connected at Rosanky Baptist Church: Sunday worship, Church Center, Facebook, prayer, and giving."
>
  <PageHero
    title="Get connected"
    lede="Find a Sunday, open Church Center, or see the church family on Facebook."
  />
  <section class="band band-tight">
    <div class="band-inner stack">
      <TodoNote title="TODO">
        <p>
          The current /get-connected page does not contain church-specific copy. It shows Squarespace template text (“Whatever it is, the way you tell your story online can make all the difference,” plus “Make it / Dream it / Build it / Grow it”) and stock photos from another Squarespace site. Those placeholders are not repeated here. The footer button labeled Get Connected also has an empty link on the current site.
        </p>
      </TodoNote>
      <ul class="path-list">
        {
          paths.map((path) => (
            <li>
              <a
                href={path.href}
                target={path.external ? "_blank" : undefined}
                rel={path.external ? "noopener noreferrer" : undefined}
              >
                <span>
                  <span class="path-title">{path.title}</span>
                  <span class="path-body">{path.body}</span>
                </span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
