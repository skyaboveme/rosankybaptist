---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const ways = [
  {
    image: "/images/give/on-site.png",
    alt: "Sign reading On Site Church.",
    title: "Give on site",
    body: `Give on site at the church located at ${site.streetShort} during Sunday 9:00 AM (Bible Study) and 10:00 AM (Worship).`,
  },
  {
    image: "/images/give/mail-check.png",
    alt: "Sign reading Mail Check.",
    title: "Mail a check",
    body: 'Please write checks payable to "Rosanky Baptist Church".',
    extra: site.mailingAddress.join(", "),
  },
  {
    image: "/images/give/online.png",
    alt: "Sign reading Online Giving.",
    title: "Give online",
    href: site.giveOnline,
    body: "Give online through the church’s Vanco giving page.",
  },
];
---

<Base
  title="Give | Support Community Growth Today"
  description="Learn how to give at Rosanky Baptist Church through onsite or online donations and join us in spreading the Gospel in Rosanky, TX."
  leaf="Give"
>
  <PageHero
    title="Give"
    lede="Learn how to give at Rosanky Baptist Church through onsite or online donations."
  />
  <section class="page-wrap" style="padding-top:0.5rem; padding-bottom:0">
    <p class="hero-actions">
      <a class="link-arrow" href={site.giveOnline} target="_blank" rel="noopener noreferrer">Give online</a>
    </p>
  </section>
  <section class="page-wrap" style="padding-top:1.5rem">
    {
      ways.map((way) => (
        <article class="give-row">
          <img src={way.image} alt={way.alt} width="200" height="200" />
          <div>
            <h2>{way.title}</h2>
            <p class="mt-2 ink-soft">{way.body}</p>
            {way.extra && <p class="mt-2 font-semibold">{way.extra}</p>}
            {way.href && (
              <p class="mt-3">
                <a class="link-arrow" href={way.href} target="_blank" rel="noopener noreferrer">
                  Give online
                </a>
              </p>
            )}
          </div>
        </article>
      ))
    }
  </section>
</Base>
