---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const ways = [
  {
    image: "/images/give/on-site.png",
    alt: "Sign reading On Site Church.",
    title: "Give on site",
    body: `Give on site at the church located at ${site.streetShort} during Sunday 9:00 AM (Bible Study) and 10:00 AM (Worship).`,
  },
  {
    image: "/images/give/mail-check.png",
    alt: "Sign reading Mail Check.",
    title: "Mail a check",
    body: 'Please write checks payable to "Rosanky Baptist Church".',
    extra: site.mailingAddress.join(", "),
  },
  {
    image: "/images/give/online.png",
    alt: "Sign reading Online Giving.",
    title: "Give online",
    href: site.giveOnline,
    body: "Give online through the church’s Vanco giving page.",
  },
];
---

<Base
  title="Give | Support Community Growth Today"
  description="Learn how to give at Rosanky Baptist Church through onsite or online donations and join us in spreading the Gospel in Rosanky, TX."
>
  <PageHero
    title="Give"
    lede="Learn how to give at Rosanky Baptist Church through onsite or online donations."
  />
  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-14 md:grid-cols-3 md:px-6">
    {
      ways.map((way) => (
        <article class="flex flex-col rounded-2xl bg-paper p-6 shadow-sm">
          <img src={way.image} alt={way.alt} class="h-28 w-28 object-contain" width="200" height="200" />
          <h2 class="mt-4 font-serif text-2xl">{way.title}</h2>
          <p class="mt-3 flex-1 text-ink-soft">{way.body}</p>
          {way.extra && <p class="mt-3 font-semibold">{way.extra}</p>}
          {way.href && (
            <a
              href={way.href}
              class="mt-5 inline-block rounded-full bg-brick px-4 py-2 text-center font-semibold text-paper"
              target="_blank"
              rel="noopener noreferrer"
            >
              Give online
            </a>
          )}
        </article>
      ))
    }
  </section>
</Base>
