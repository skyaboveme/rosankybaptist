---
interface Props {
  title?: string;
}
const { title = "TODO" } = Astro.props;
---

<aside class="rounded-2xl border border-gold/50 bg-[#fff8e8] px-5 py-4 text-ink" role="note">
  <p class="text-sm font-bold tracking-[0.16em] text-brick uppercase">{title}</p>
  <div class="mt-2 space-y-2 text-sm leading-relaxed">
    <slot />
  </div>
</aside>
