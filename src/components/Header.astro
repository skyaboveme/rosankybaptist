---
import { nav, site } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<a class="skip" href="#main">Skip to content</a>
<div class="scroll-progress" aria-hidden="true"></div>

<header class="masthead">
  <div class="masthead-inner">
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>
      <img src="/images/logo-light.png" alt="" width="280" height="72" />
    </a>
    <button id="menu-toggle" class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="sr-only">Open menu</span>
      Menu
    </button>
    <nav class="nav-links" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="give-online" href={site.giveOnline} target="_blank" rel="noopener noreferrer">Give online</a>
      <a href={site.churchCenter} target="_blank" rel="noopener noreferrer">Members</a>
    </nav>
  </div>
  <nav id="mobile-nav" class="mobile-panel" aria-label="Mobile" hidden>
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href={site.giveOnline} target="_blank" rel="noopener noreferrer">Give online</a>
    <a href={site.churchCenter} target="_blank" rel="noopener noreferrer">Members</a>
  </nav>
</header>

<style>
  .skip {
    position: absolute;
    left: 0.8rem;
    top: 0.6rem;
    z-index: 70;
    transform: translateY(-150%);
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 0.4rem 0.7rem;
  }
  .skip:focus {
    transform: none;
  }
</style>

<script>
  function bindMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-nav");
    if (!toggle || !menu || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";
    toggle.addEventListener("click", () => {
      const open = menu.hasAttribute("hidden");
      menu.toggleAttribute("hidden", !open);
      menu.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      const label = toggle.querySelector(".sr-only");
      if (label) label.textContent = open ? "Close menu" : "Open menu";
    });
  }

  bindMenu();
  document.addEventListener("astro:page-load", bindMenu);
</script>
