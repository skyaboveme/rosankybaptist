---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="bg-navy text-cream">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    {eyebrow && <p class="text-sm font-semibold tracking-[0.22em] text-gold uppercase">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl font-serif text-4xl leading-tight md:text-5xl">{title}</h1>
    {lede && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cream/85">{lede}</p>}
  </div>
</section>
