---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  {eyebrow && <p class="kicker"><span class="cross" aria-hidden="true"></span>{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</section>
