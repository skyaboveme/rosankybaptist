---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="vision">
    <p class="kicker" style="color:#e7c98a; margin-bottom:0.7rem;">Vision</p>
    <p>{site.vision}</p>
  </div>
  <div class="footer-row">
    <p>
      <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a><br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p>
      <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">
        {site.streetLine1}<br />{site.city}, {site.region} {site.postalCode}
      </a>
    </p>
    <p>
      <a href="/give">Give</a><br />
      <a href={site.giveOnline} target="_blank" rel="noopener noreferrer">Give online</a><br />
      <a href="/pray-for-me">Pray For Me</a><br />
      <a href="/get-connected">Get Connected</a><br />
      <a href="/contact">Contact</a>
    </p>
  </div>
  <p class="legal">© {new Date().getFullYear()} {site.name}. All Rights Reserved.</p>
</footer>
